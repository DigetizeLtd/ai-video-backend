# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/neural/

# Ruflo local vector/memory stores (regenerated per machine, not shared state)
.swarm/
ruvector.db
*.db-wal
*.db-shm

# Ruflo per-session runtime state (daemon PIDs, generated scans, resolved policy)
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/harness-active-policy.json
.claude-flow/policy/
.claude-flow/metrics/

.claude/proven-config.json
.claude/.proven-config-version

# Python
__pycache__/
*.py[cod]
venv/
.venv/
